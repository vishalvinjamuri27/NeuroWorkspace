# Local Compose/development defaults only. Replace every placeholder secret in
# non-local environments and use the deployment platform's secret manager.
ENVIRONMENT=development

# Database, broker, and canonical signal storage.
DATABASE_URL=postgresql+psycopg://neuroworkspace:neuroworkspace@postgres:5432/neuroworkspace
REDIS_URL=redis://redis:6379/0
OBJECT_STORE_BACKEND=s3
OBJECT_STORE_ROOT=/data/objects

# Private S3-compatible source/export storage. These values target local MinIO.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=neuroworkspace
S3_SECRET_KEY=change-me-in-non-local-environments
S3_BUCKET=neuroworkspace

# Sessions and identity. Hosted deployments must disable development auth and
# configure an HTTPS OIDC provider. Leave OIDC values empty for local auth.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=nw_session
SESSION_TTL_SECONDS=28800
DEV_AUTH_ENABLED=true
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ALPHA_ADMIN_EMAILS=researcher@example.test

# Public origins and browser build-time values. Leave the repository URL empty
# to hide the landing page's source links.
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/vishalvinjamuri27/NeuroWorkspace

# Worker, readiness, request, and waveform resource limits.
# Compose bootstraps the checksum-pinned public sample before API readiness.
REQUIRE_DEMO_READY=true
WORKER_EAGER=false
MAX_UPLOAD_BYTES=21474836480
MAX_UPLOAD_FILES=16
MAX_WAVEFORM_CHANNELS=256
MAX_WAVEFORM_PIXELS=4096
MAX_WAVEFORM_POINTS=1500000
WAVEFORM_CACHE_SECONDS=300

# Observability and release identity.
LOG_LEVEL=INFO
BUILD_VERSION=0.1.0-alpha.1
FEATURE_FLAGS=
